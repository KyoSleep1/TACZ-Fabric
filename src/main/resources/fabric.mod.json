{
	"schemaVersion": 1,
	"id": "tacz",
	"version": "${version}",
	"name": "Timeless & Classics Guns: Zero",
	"description": "A port of the Timeless & Classics Guns mod to Minecraft 1.21.1 made for Eufonia Studio.",
	"authors": [
		"Serene Wave Studio | Modified by We-Cant-Coding & KyoSleep"
	],
	"contact": {
		"issues": "https://github.com/We-Cant-Coding/TACZ-Fabric/issues",
		"sources": "https://github.com/We-Cant-Coding/TACZ-Fabric"
	},
	"license": "GPL-3.0",
	"icon": "assets/tacz/icon.png",
	"environment": "*",
	"entrypoints": {
		"fabric-datagen": [
			"com.tacz.guns.GunModDataGen"
		],
		"main": [
			"com.tacz.guns.GunMod"
		],
		"client": [
			"com.tacz.guns.GunModClient"
		]
	},
	"mixins": [
		"tacz.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.16.10",
		"minecraft": "1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	},
	"custom": {
		"loom:injected_interfaces": {
			"net/minecraft/class_276": [
				"com/tacz/guns/api/mixin/FramebufferStencil"
			],
			"net/minecraft/class_1309": [
				"com/tacz/guns/api/mixin/ItemHandlerCapability"
			]
		},
		"cardinal-components": [
			"tacz:synced_entity_data"
		]
	},
	"accessWidener": "tacz.accesswidener"
}